# Copie este archivo a .env y ajuste los valores.
#   cp .env.example .env

# Contraseña de los 7 usuarios iniciales (admin, gerencia, supervisor,
# amadellaves, mantenimiento, sistemas, recepcion). Sólo se aplica en el
# primer arranque; el sistema exige cambiarla al entrar. OBLIGATORIA.
CDH_SEED_PASSWORD= Aqui va contra

# Zona horaria del hotel. Sella fecha y hora de cada movimiento del historial.
# America/Tijuana (Baja California) observa horario de verano, a diferencia del
# resto de México: use la zona IANA, nunca un desfase fijo.
CDH_TZ=America/Tijuana

# Dominio con HTTPS, sólo para el despliegue con Caddy
# (docker-compose.caddy.yml). Debe apuntar por DNS a la IP de esta máquina;
# Caddy pide y renueva el certificado solo. Sin dominio no hay HTTPS válido.
CDH_DOMAIN=cdh.suhotel.com

# Puerto e interfaz publicados en el anfitrión.
# 127.0.0.1 mantiene el servicio detrás de un proxy inverso; use 0.0.0.0
# sólo si va a exponerlo directamente y ya resolvió el HTTPS.
CDH_PORT=3000
CDH_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Entrada única desde Core Quartz (opcional)
#
# Las tres variables son opcionales y van juntas: sin ellas el CDH funciona
# exactamente como siempre, con su propio inicio de sesión y en la raíz.
# ---------------------------------------------------------------------------

# Prefijo bajo el que se sirve todo el CDH. Vacío = en la raíz, como hoy.
# Con /cdh puede publicarse en core-quartz.vercel.app/cdh/.
# CDH_BASE_PATH=/cdh

# Dirección **interna** del shell de Core Quartz (red privada, nunca pública):
# el CDH canjea ahí el código de un solo uso.
# CQ_URL_INTERNA=http://core-quartz:4000

# Secreto compartido con el shell. Sin él —o sin CQ_URL_INTERNA— las rutas de
# entrada única no existen (404) y nadie puede entrar por esa vía.
# CQ_SSO_SECRETO=
